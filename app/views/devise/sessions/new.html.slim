.ds-card.ds-card--auth.ds-root
  h1.ds-heading-xl Oscar's Games
  h2.ds-heading-lg Se connecter

  = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    .ds-field
      = f.label :email, "E-mail", class: "ds-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "ds-input"

    .ds-field data-controller="password"
      = f.label :password, "Mot de passe", class: "ds-label"
      .ds-password-row
        = f.password_field :password, autocomplete: "current-password", class: "ds-input", data: { password_target: "input" }
        button.ds-btn.ds-btn-secondary type="button" data-password-target="toggle" data-action="click->password#toggle" Afficher

    - if devise_mapping.rememberable?
      .ds-checkbox-row.ds-field
        = f.check_box :remember_me
        = f.label :remember_me, "Se souvenir de moi", class: "ds-label"

    .ds-actions
      = f.submit "Se connecter", class: "ds-btn ds-btn-primary"

  .ds-links
    = render "devise/shared/links"
