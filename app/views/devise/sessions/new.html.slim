h2 Se connecter

= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
  .field
    p = f.label :email, "E-mail"
    p = f.email_field :email, autofocus: true, autocomplete: "email"

  .field
    p = f.label :password, "Mot de passe"
    p = f.password_field :password, autocomplete: "current-password"

  - if devise_mapping.rememberable?
    .field
      p = f.check_box :remember_me
      p = f.label :remember_me, "Se souvenir de moi"

  .actions
    = f.submit "Se connecter"

= render "devise/shared/links"
