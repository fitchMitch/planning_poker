.ds-card.ds-root
  h2.ds-heading-lg Mot de passe oublié ?

  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
    = render "devise/shared/error_messages", resource: resource

    .ds-field
      = f.label :email, "E-mail", class: "ds-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "ds-input"

    .ds-actions
      = f.submit "Envoyer les instructions de réinitialisation", class: "ds-btn ds-btn-primary"

  .ds-links
    = render "devise/shared/links"
