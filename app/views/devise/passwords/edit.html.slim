h2 Changer de mot de passe

= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
  = render "devise/shared/error_messages", resource: resource
  = f.hidden_field :reset_password_token

  .field
    p = f.label :password, "Nouveau mot de passe"
    - if @minimum_password_length
      p
        em
          | (#{@minimum_password_length} caractères minimum)
    p = f.password_field :password, autofocus: true, autocomplete: "new-password"

  .field
    p = f.label :password_confirmation, "Confirmation du nouveau mot de passe"
    p = f.password_field :password_confirmation, autocomplete: "new-password"

  .actions
    = f.submit "Changer mon mot de passe"

= render "devise/shared/links"
