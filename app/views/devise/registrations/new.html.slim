.ds-card.ds-root
  h2.ds-heading-lg S'inscrire

  = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    = render "devise/shared/error_messages", resource: resource

    .ds-field
      = f.label :email, "E-mail", class: "ds-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "ds-input"

    .ds-field
      = f.label :password, "Mot de passe", class: "ds-label"
      = f.password_field :password, autocomplete: "new-password", class: "ds-input"
      - if @minimum_password_length
        span.ds-hint = "#{@minimum_password_length} caractères minimum"

    .ds-field
      = f.label :password_confirmation, "Confirmation du mot de passe", class: "ds-label"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "ds-input"

    .ds-actions
      = f.submit "S'inscrire", class: "ds-btn ds-btn-primary"

  .ds-links
    = render "devise/shared/links"
