.ds-root
  - if user_signed_in?
    = render "shared/nav", game_type: @game_type

    main.hero
      h1.ds-heading-xl
        | Bon retour sur
        '
        span style="color: var(--accent);" = @game_type.name
        '
        | !
      p.ds-body.lede Prête à estimer ? Créez une nouvelle partie ou rejoignez-en une déjà en cours.
      .hero-actions
        - if current_user.current_game
          button.ds-btn.ds-btn-primary type="button" disabled=true Créer une partie
          span.ds-hint Vous participez déjà à #{current_user.current_game.name}
        - else
          = link_to "Créer une partie", new_game_type_game_path(@game_type.slug), class: "ds-btn ds-btn-primary"
        = link_to "Parcourir les parties", games_path, class: "ds-btn ds-btn-secondary"

    .page
      .games-columns
        section
          h2.ds-heading-lg Parties récentes
          .ds-card-list
            - @recent_games.each do |game|
              - active = current_user.current_game == game
              .ds-card class=("ds-card--active" if active)
                .ds-card-info
                  span.ds-body-sm = game.name
                  span.ds-hint = game.creator&.email
                - if active
                  span.ds-badge En cours
          = link_to "Voir toutes les parties", games_path, class: "ds-btn ds-btn-secondary"

        = render "shared/my_games", my_games: @my_games

  - else
    header.nav
      .nav-brand
        .nav-logo PP
        span.ds-heading-md Planning Poker
      ul.nav-links
        li: a.is-active href="#" Accueil
        li: a href="#" Comment ça marche
      .nav-actions
        = link_to "Se connecter", new_user_session_path, class: "ds-btn ds-btn-secondary"
        = link_to "S'inscrire", new_user_registration_path, class: "ds-btn ds-btn-primary"

    main.hero
      span.hero-eyebrow Gratuit · Sans installation
      h1.ds-heading-xl Estimez vos tickets en équipe, sans effort.
      p.ds-body.lede
        | Planning Poker réunit votre équipe autour d'une estimation collective en temps réel. Créez une partie, invitez vos collègues, votez.
      .hero-actions
        a.ds-btn.ds-btn-primary href="#" Créer une partie
        = link_to "Voir comment ça marche", "#", class: "ds-btn ds-btn-secondary"

    section.how aria-label="Comment ça marche"
      .ds-card.step-card
        .step-num 1
        h3.ds-heading-md Créez une partie
        p.ds-body-sm Choisissez un nom, votre partie est immédiatement visible et accessible par lien.
      .ds-card.step-card
        .step-num 2
        h3.ds-heading-md Invitez votre équipe
        p.ds-body-sm Chaque coéquipier rejoint via une demande, validée par vous ou un participant.
      .ds-card.step-card
        .step-num 3
        h3.ds-heading-md Estimez ensemble
        p.ds-body-sm Votez en même temps, révélez les cartes, et avancez vers un consensus.

    p.footer-note.ds-body-sm
      ' Déjà inscrit ?
      = link_to "Connectez-vous", new_user_session_path, style: "color: var(--primary);"
      | &nbsp;pour retrouver vos parties.
