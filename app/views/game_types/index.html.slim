.ds-root
  header.nav
    .nav-brand
      .nav-logo PP
      span.ds-heading-md Oscar's Games
    .nav-actions
      - if user_signed_in?
        span.ds-body-sm style="color: var(--ink-muted);" = current_user.email
        = button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "ds-btn ds-btn-secondary"
      - else
        = link_to "Se connecter", new_user_session_path, class: "ds-btn ds-btn-secondary"
        = link_to "S'inscrire", new_user_registration_path, class: "ds-btn ds-btn-primary"
  main
    h1.ds-heading-xl Choisissez un jeu
    - @game_types.each do |game_type|
      .ds-card
        h2.ds-heading-md style="color: var(--accent);" = game_type.name
        p.ds-body-sm = game_type.description
        = link_to "Participer", game_type_path(game_type.slug), class: "ds-btn ds-btn-primary"
