.ds-root data-controller="heartbeat" data-heartbeat-url-value="#{heartbeat_game_path(@game)}"
  = render "shared/nav", game_type: @game.game_type
  .page
    h1.ds-heading-xl = @game.name

    - if @current_participant.creator?
      .ds-description-edit data-controller="inline-edit"
        .ds-description-row data-inline-edit-target="display"
          p.ds-body = @game.description
          button.ds-btn.ds-btn-secondary type="button" data-action="click->inline-edit#toggle" aria-label="Modifier la description" ✏️
        = form_with model: @game, url: game_path(@game), method: :patch, html: { data: { inline_edit_target: "form" }, hidden: true } do |f|
          .ds-field
            = f.text_area :description, class: "ds-input"
          .ds-actions
            = f.submit "Enregistrer", class: "ds-btn ds-btn-primary"
            button.ds-btn.ds-btn-secondary type="button" data-action="click->inline-edit#cancel" Annuler
    - else
      p.ds-body = @game.description

    section
      h2.ds-heading-lg Participants
      ul
        - @participants.each do |participant|
          li = participant.user.email + (participant.creator? ? " (créateur)" : "")

    - if @pending_join_requests.any?
      section
        h2.ds-heading-lg Demandes en attente
        - @pending_join_requests.each do |join_request|
          .ds-card
            span = join_request.user.email
            = button_to "Accepter", accept_join_request_path(join_request), method: :patch, class: "ds-btn ds-btn-primary"
            = button_to "Refuser", reject_join_request_path(join_request), method: :patch, class: "ds-btn ds-btn-secondary"

    - other_active = @participants.where.not(id: @current_participant.id)
    - if @current_participant.creator? && @game.state == "in_progress" && other_active.any?
      = form_with url: leave_game_path(@game), method: :post do |f|
        = f.label :successor_id, "Désigner le prochain créateur", class: "ds-label"
        = f.select :successor_id, other_active.map { |p| [ p.user.email, p.id ] }, include_blank: "Choix aléatoire", class: "ds-input"
        = f.submit "Quitter la partie", class: "ds-btn ds-btn-secondary"
    - else
      = button_to "Quitter la partie", leave_game_path(@game), method: :post, class: "ds-btn ds-btn-secondary"
