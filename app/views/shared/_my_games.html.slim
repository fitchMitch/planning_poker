section
  h2.ds-heading-lg Mes parties
  - if my_games.none?
    p.ds-body-sm Vous n'avez participé à aucune partie.
  - else
    .ds-card-list
      - my_games.each do |game|
        - rejoinable = game.state != "ended" && game.participants.active.exists?(user: current_user)
        .ds-card
          h3.ds-heading-md = game.name
          - if game.creator && game.creator != current_user
            span.ds-hint = "Créateur : #{game.creator.email}"
          - if rejoinable
            = link_to "Retourner à la partie", game_path(game), class: "ds-btn ds-btn-primary"
          - elsif game.state == "ended"
            span.ds-status Terminée
          - else
            span.ds-status Quittée
